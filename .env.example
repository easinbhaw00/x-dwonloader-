# XENO server settings
XENO_DOWNLOAD_DIR=downloads
XENO_DB_PATH=data/xeno.sqlite3
XENO_MAX_FILE_MB=250
XENO_ALLOWED_MEDIA_HOSTS=video.twimg.com
XENO_FXTWITTER_API=https://api.fxtwitter.com
XENO_PROVIDER_TIMEOUT=20
# Keep sensitive content disabled unless authorization and age eligibility are verified.
XENO_ALLOW_SENSITIVE_WITH_PROVIDER=false
XENO_AGE_ELIGIBILITY_VERIFIED=false
# Telegram bot is optional
TELEGRAM_BOT_TOKEN=
XENO_API_URL=http://127.0.0.1:8000
XENO_TELEGRAM_MAX_SEND_MB=45

# Optional comma-separated HTTPS API base URLs for operator-managed compatible providers.
# Leave empty unless you control and have verified the provider.
XENO_FX_API_EXTRA_BASES=

# v7 provider reliability (bounded values)
XENO_PROVIDER_RETRIES=1
XENO_PROVIDER_COOLDOWN_SECONDS=45
XENO_METADATA_CACHE_SECONDS=20
